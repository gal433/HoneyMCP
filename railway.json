{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "honeypot/**",
      "requirements.txt",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m honeypot.server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
